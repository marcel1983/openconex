<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime exceptions for the PyInstaller bundle (SPDX: GPL-3.0-or-later).
  - allow-jit / allow-unsigned-executable-memory: Qt WebEngine (Chromium V8) for the
    PDF report and the embedded Python runtime.
  - disable-library-validation: PyInstaller loads Python extension modules and
    Qt/OpenCASCADE libraries that are signed with the same identity at build time,
    but some third-party wheels ship their own ad-hoc signatures.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
